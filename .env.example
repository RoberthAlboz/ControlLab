# ---------------------------------------------------------------------------
# Control Lab — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores. O `.env` não vai para o git.
# ---------------------------------------------------------------------------

# Ambiente: development | production
NODE_ENV=development

# Porta do servidor (frontend + API no mesmo endereço)
PORT=3000

# Endereço público do sistema (usado na documentação e em links)
APP_URL=http://localhost:3000

# Banco de dados: sqlite (padrão, banco principal) ou postgres (ex.: Supabase).
DATABASE_PROVIDER=sqlite

# SQLite: um arquivo dentro do projeto (criado por `pnpm db:setup`).
# O SQLite já vem no Node.js 22.16+; não é preciso instalar servidor de banco.
DATABASE_FILE=data/forgelab.db

# Postgres/Supabase (somente com DATABASE_PROVIDER=postgres).
# Supabase: botão "Connect" do projeto → "Session pooler" (porta 5432). Troque
# [YOUR-PASSWORD] pela senha do banco; caracteres especiais precisam de URL-encode.
DATABASE_URL=
# SSL: require (padrão, Supabase) | verify (valida o certificado; use DATABASE_SSL_CA) | disable (Postgres local)
DATABASE_SSL=require

# Segredo que assina as sessões. Use uma frase longa e aleatória (>= 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-este-segredo-de-desenvolvimento-por-um-valor-aleatorio

# Duração da sessão em horas (expira automaticamente; o logout revoga na hora).
SESSION_TTL_HOURS=12

# Pasta onde ficam as imagens enviadas (fotos de perfil e imagens de módulos).
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# Contas de DESENVOLVIMENTO criadas por `pnpm db:seed` / `pnpm db:setup`.
# Servem apenas para testar o sistema localmente — não use em produção.
# Para contas reais, use: pnpm user:create -- --email ... --name "..." --role teacher
# ---------------------------------------------------------------------------
SEED_TEACHER_EMAIL=docente@forgelab.local
SEED_TEACHER_NAME=Docente Control Lab
SEED_TEACHER_PASSWORD=docente-dev-123

SEED_STUDENT_EMAIL=aluno@forgelab.local
SEED_STUDENT_NAME=Aluno Control Lab
SEED_STUDENT_PASSWORD=aluno-dev-123

# true = a seed redefine as senhas das contas acima para os valores deste arquivo
SEED_RESET_PASSWORDS=false
